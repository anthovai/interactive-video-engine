# Copy to .env and fill in. Never commit .env.

# The key the studio and the engine share. Long and random:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
KAIIV_API_KEY=

# Signs the sign-in cookie. Long and random, different from the key above.
KAIIV_STUDIO_SECRET=

# The first administrator, created on the first start only. At least 10
# characters with lower case, upper case and a digit. Change it after signing
# in, then you may remove it from here.
KAIIV_ADMIN_USER=admin
KAIIV_ADMIN_PASSWORD=

# 1 when the studio is served over HTTPS (it should be, for real use).
KAIIV_SECURE_COOKIES=0

# Where the studio listens.
KAIIV_BIND=127.0.0.1
KAIIV_PORT=8300
