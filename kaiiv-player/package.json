{
  "name": "@kaiser/kaiiv-player",
  "version": "1.0.0",
  "description": "KAISER interactive video player: questions on a video, marked on the server, with no answer ever sent to the browser.",
  "main": "dist/kaiiv-player.js",
  "module": "dist/kaiiv-player.esm.js",
  "style": "dist/kaiiv-player.css",
  "files": ["dist", "src", "styles", "thirdparty", "README.md"],
  "scripts": {
    "build": "webpack --mode production && node tools/build-styles.js",
    "dev": "webpack --mode development && node tools/build-styles.js",
    "test": "node tests/smoke.js && python tests/check_fork.py",
    "check": "python tests/check_fork.py"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "babel-loader": "^9.1.3",
    "jquery": "3.7.1",
    "jquery-ui": "1.14.1",
    "jsdom": "^30.1.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  }
}
